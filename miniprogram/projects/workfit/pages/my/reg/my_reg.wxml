<view wx:if="{{isLoad===null}}" class="margin-top load notexist text-l load-project"></view>
<view wx:if="{{isLoad===false}}" class="margin-top load loading text-l load-project"></view>

<view wx:if="{{isLoad}}" class="main padding-project">
	<include src="../edit/user_form.wxml" />

	<view class="agreement-check-container">
		<checkbox-group bindchange="bindAgreementChange">
			<view class="agreement-check-label">
				<checkbox value="agreed" checked="{{agreed}}" color="#FED202" />
				<text class="agreement-text">我已阅读并同意</text>
				<text class="agreement-link" catchtap="openLegal" data-type="agreement">《用户服务协议》</text>
				<text class="agreement-text">和</text>
				<text class="agreement-link" catchtap="openLegal" data-type="privacy">《隐私政策》</text>
			</view>
		</checkbox-group>
	</view>

	<button bindtap="bindSubmitTap" class="btn-base btn-project shadow">提交注册</button>
</view>