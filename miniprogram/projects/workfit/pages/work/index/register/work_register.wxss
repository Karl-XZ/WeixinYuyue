@import '../../../../style/work.wxss';

.main-work {
	width: 100%;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	position: relative;
}

.login {
	width: 550rpx;
	background-color: #fff;
	min-height: 650rpx;
	border-radius: 20rpx;
	border-bottom-left-radius: 70rpx;
	border-top-right-radius: 70rpx;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	padding: 50rpx 20rpx;
	margin-top: -100rpx;
}

.login button {
	width: 85%;
	color: #fff;
	font-size: 32rpx;
}

.login .hint {
	width: 100%;
	color: #000;
	font-weight: bold;
	font-size: 36rpx;
	text-align: center;
}

.login .return {
	width: 100%;
	text-align: center;
	font-size: 26rpx;
}

.agreement-check-container {
	width: 100%;
	padding: 30rpx 20rpx;
	margin-bottom: 20rpx;
}

.agreement-check-label {
	display: flex;
	align-items: flex-start;
	font-size: 26rpx;
	line-height: 1.6;
}

.agreement-check-label checkbox {
	margin-top: 4rpx;
	margin-right: 10rpx;
}

.agreement-text {
	color: #666;
}

.agreement-link {
	color: #576b95;
	text-decoration: underline;
}

.form-group .title {
	color: #333;
}

.pic {
	width: 180rpx;
	height: 180rpx;
	font-size: 130rpx;
	display: flex;
	justify-content: center;
	align-items: center;
}

.form-group {
	position: relative;
}

.code-btn-container {
	width: 100%;
	padding: 0 20rpx;
	margin-bottom: 20rpx;
}

.code-btn-full {
	width: 100%;
	height: 70rpx;
	line-height: 70rpx;
	padding: 0;
	font-size: 28rpx;
	background-color: #1C9399;
	color: #fff;
	border-radius: 10rpx;
	border: none;
}

.code-btn-full[disabled] {
	background-color: #ccc;
	color: #999;
}
