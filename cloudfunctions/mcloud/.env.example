# 邮件服务配置示例
# 复制此文件为 .env 并填写实际值（如果需要使用环境变量）

# SMTP服务器地址
SMTP_HOST=smtp.163.com

# SMTP端口（465为SSL端口，25为非SSL端口）
SMTP_PORT=465

# 是否使用SSL加密连接
SMTP_SECURE=true

# 发件邮箱账号
SMTP_USER=your_email@163.com

# 邮箱授权码（不是邮箱密码！）
# 163邮箱授权码获取方式：
# 1. 登录163邮箱网页版
# 2. 设置 -> POP3/SMTP/IMAP
# 3. 开启服务并获取授权码
SMTP_PASS=your_smtp_auth_code_here

# 发件人显示名称（可选）
MAIL_FROM=课程预约系统 <your_email@163.com>

# 其他邮箱服务商配置参考：
# 
# QQ邮箱：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# 
# Gmail：
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# 
# 阿里云邮箱：
# SMTP_HOST=smtp.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE=true
